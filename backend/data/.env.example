# langlab 后端配置模板
#
# 用法：
#   cp backend/data/.env.example backend/data/.env
#   然后填入你自己的 Key
#
# ⚠️ 所有 Key 都是**可选**的：一个都不填也能跑
#    （卡片、阅读、复习、本地发音诊断都不依赖它们）。
#    填了才会启用对应的在线能力。

# ── 对话 / 释义（虚拟老师、建卡时自动补释义）──
# 兼容任何 OpenAI 风格接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 语音合成（可选；默认引擎 Edge TTS 免 Key）──
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=
MINIMAX_TTS_MODEL=

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
COSYVOICE_MODEL=

DOUBAO_API_KEY=
DOUBAO_RESOURCE_ID=

# ── 通用 ──
APP_TIMEZONE=Asia/Shanghai

# 默认 sqlite；改为 mysql 时另需 DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD
# DB_CONNECTION=sqlite
